    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@workspace/typescript-config": "workspace:*",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
