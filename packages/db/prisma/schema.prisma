generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// Values are SCREAMING_SNAKE_CASE to exactly match the `as const` objects in
// packages/shared/src/types/incident.ts and user.ts. If they drift, Prisma
// call sites in apps/api will surface type errors at compile time.
// ─────────────────────────────────────────────────────────────────────────────

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATING
  RESOLVED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum OpState {
  PENDING    // not yet incorporated into a snapshot
  CONFIRMED  // acknowledged by the server and persisted
  FAILED     // rejected — client should discard and re-sync
}

enum OperationType {
  TEXT  // Yjs CRDT delta — collaborative notes
  FIELD // structured field mutation: status, severity, title, etc.
}

enum UserRole {
  OWNER
  ADMIN
  ENGINEER
  VIEWER
}

enum BillingStatus {
  ACTIVE
  PAST_DUE  
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  stripeCustomerId String?       @unique
  billingStatus    BillingStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())

  users         User[]
  incidents     Incident[]
  subscription  Subscription?
  billingEvents BillingEvent[]
  invitations   Invitation[]
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  role           UserRole @default(VIEWER)
  organizationId String
  displayName    String
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id])
  incidentAssignments IncidentAssignee[]
  operations          Operation[]
  sentInvitations     Invitation[]       @relation("InvitationSender")

  @@index([organizationId])
  @@index([role, organizationId])
}

model Incident {
  id             String         @id @default(uuid())
  organizationId String
  title          String
  status         IncidentStatus @default(OPEN)
  severity       Severity
  yjsSnapshot    Bytes?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  assignees    IncidentAssignee[]
  operations   Operation[]

  @@index([organizationId, status])
  @@index([severity])
  @@index([updatedAt])
}

// Junction table — an incident can have multiple assignees
model IncidentAssignee {
  incidentId String
  userId     String
  assignedAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([incidentId, userId])
  @@index([userId]) // "all incidents assigned to user X"
}

model Operation {
  id         String        @id @default(uuid())
  incidentId String
  authorId   String
  type       OperationType
  payload    Json
  opState    OpState       @default(PENDING)
  messageId  String        @unique
  createdAt  DateTime      @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([incidentId, createdAt])
}

model Subscription {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  stripeSubscriptionId String   @unique
  stripeSeatItemId     String
  stripeIncidentItemId String
  status               String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model BillingEvent {
  id             String    @id @default(uuid())
  organizationId String
  stripeEventId  String    @unique
  type           String
  processedAt    DateTime?
  raw            Json
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// A pending request for someone to join an organization. The raw token is
// only ever held by the invitee's link — only its hash is persisted, same
// pattern as refresh tokens and API keys (see ADR-02, security-design.md).
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           UserRole         @default(VIEWER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}