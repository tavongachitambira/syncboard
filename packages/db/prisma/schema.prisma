generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum values are SCREAMING_SNAKE_CASE and mirror the `as const` objects in
// packages/shared (types/incident.ts, types/user.ts). packages/shared is the
// source of truth for the wire values; keep these in sync by hand.
//
// Referential actions: parent -> child ownership uses Cascade (see the cascade
// table in apps/docs/architecture/database-design.md). References to people and
// services use NoAction instead of Restrict. Both block a delete that would
// orphan a row, but NoAction is checked at the end of the statement, so
// deleting an organization can still cascade through every table at once.

enum UserRole {
  OWNER
  ADMIN
  ENGINEER
  VIEWER
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATING
  RESOLVED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum OpState {
  PENDING
  CONFIRMED
  FAILED
}

// Operation.payload is a binary Yjs update, so there is only one kind today.
// Structured field changes go through the REST API, not the operation log.
enum OperationType {
  YJS_UPDATE
}

enum ActivityType {
  INCIDENT_CREATED
  STATUS_CHANGED
  SEVERITY_CHANGED
  TITLE_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENT_ADDED
  RESOLVED
}

enum NotificationType {
  ASSIGNMENT
  INCIDENT_CREATED
  MENTION
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  services      Service[]
  incidents     Incident[]
  invitations   Invitation[]
  apiKeys       ApiKey[]
  notifications Notification[]
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  displayName    String
  avatarUrl      String?
  role           UserRole @default(VIEWER)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownedServices       Service[]
  incidentAssignments IncidentAssignee[]
  operations          Operation[]
  comments            Comment[]
  activities          Activity[]
  notifications       Notification[]
  sentInvitations     Invitation[]

  @@index([organizationId])
  @@index([role, organizationId])
}

model Service {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: NoAction)
  incidents    Incident[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Incident {
  id             String         @id @default(uuid())
  organizationId String
  serviceId      String
  title          String
  severity       Severity
  status         IncidentStatus @default(OPEN)
  // Optimistic concurrency for structured fields; notes are handled by Yjs.
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service            @relation(fields: [serviceId], references: [id], onDelete: NoAction)
  assignees    IncidentAssignee[]
  comments     Comment[]
  activities   Activity[]
  operations   Operation[]
  document     IncidentDocument?

  @@index([organizationId, status])
  @@index([serviceId, status])
  @@index([severity])
  @@index([updatedAt])
}

model IncidentAssignee {
  incidentId String
  userId     String
  assignedAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([incidentId, userId])
  @@index([userId])
}

model Comment {
  id         String   @id @default(uuid())
  incidentId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: NoAction)

  @@index([incidentId, createdAt])
  @@index([authorId, createdAt])
}

// Append-only audit trail: rows are never updated or deleted by the app.
model Activity {
  id         String       @id @default(uuid())
  incidentId String
  actorId    String
  type       ActivityType
  payload    Json
  createdAt  DateTime     @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: NoAction)

  @@index([incidentId, createdAt])
}

// Latest Yjs snapshot of the shared notes. One per incident.
model IncidentDocument {
  incidentId String   @id
  snapshot   Bytes
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// Immutable log of Yjs updates. messageId is the client-generated id, unique so
// replaying the log never applies the same update twice.
model Operation {
  id         String        @id @default(uuid())
  incidentId String
  authorId   String
  messageId  String        @unique
  type       OperationType @default(YJS_UPDATE)
  payload    Bytes
  state      OpState       @default(PENDING)
  createdAt  DateTime      @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: NoAction)

  @@index([incidentId, createdAt])
}

model Notification {
  id             String             @id @default(uuid())
  organizationId String
  recipientId    String
  type           NotificationType
  payload        Json
  status         NotificationStatus @default(UNREAD)
  createdAt      DateTime           @default(now())
  readAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, status])
  @@index([recipientId, createdAt])
}

// Only the SHA-256 hash of the secret is stored. Keys are revoked, not deleted.
model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  hashedSecret   String    @unique
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Only the hash of the invitation token is stored (same pattern as refresh
// tokens and API keys).
model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           UserRole         @default(VIEWER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: NoAction)

  @@index([organizationId])
  @@index([email])
}
