# Copy to apps/socket/.env. Every variable is validated at startup (src/env.ts).
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Origin of the web app. Used for CORS and for the Origin check on connections.
WEB_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

# The PUBLIC key from apps/api/.env (same single-line format, literal \n for
# newlines). The socket server only verifies tokens; it never holds the private key.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
