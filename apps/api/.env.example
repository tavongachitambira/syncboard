# Copy to apps/api/.env. Every variable is validated at startup (src/env.ts).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Origin of the web app. Used for CORS and for the Origin check on writes.
WEB_URL=http://localhost:3000

# How many reverse proxies sit in front of the API (1 for a single Nginx or
# Caddy). Leave at 0 when clients connect directly.
TRUST_PROXY=0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncboard
REDIS_URL=redis://localhost:6379

# RS256 key pair for access tokens: PEM on a single line with literal \n for
# newlines. The private key must be PKCS#8 ("BEGIN PRIVATE KEY"); the API
# refuses to start if the pair is unusable.
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem   # -> JWT_PRIVATE_KEY
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' public.pem    # -> JWT_PUBLIC_KEY
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_KEY_ID=v1
