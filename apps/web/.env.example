# Optional. Copy to apps/web/.env.local to override.
# Defaults to the API on localhost:4000. Behind the reverse proxy in production,
# use the same-origin path instead: NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public origin used for metadata (Open Graph, canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true ONLY once optional (analytics) cookies exist; shows the consent banner.
NEXT_PUBLIC_OPTIONAL_COOKIES=false
